# Copia este archivo a .env y completa tu llave. .env está en .gitignore: nunca lo subas.
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_BASE_URL=https://api.anthropic.com/v1

# Precios reales en USD por millón de tokens (de la página de precios del proveedor).
# Si se dejan vacíos, el costo aparece como «sin precio configurado».
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=

# Pon 1 solo después de construir la imagen: docker build -t revisor-compiscript:v1 sandbox
ENABLE_RUNNER=0
RUNNER_IMAGE=revisor-compiscript:v1
PORT=8000
