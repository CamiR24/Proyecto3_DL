# Copia este archivo a .env y completa tu llave. .env está en .gitignore: nunca lo subas.
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_BASE_URL=https://api.anthropic.com/v1

# Precios en USD por millón de tokens. Valores de lista de claude-haiku-5-5 para prompts de hasta 100 000 tokens
# (consultados en la tabla de modelos de la referencia de la API, 6 oct 2026): verifícalos en la página de precios
# del proveedor antes de citar costos. Si se dejan vacíos, la aplicación muestra «sin precio configurado».
LLM_INPUT_USD_PER_MILLION=0.10
LLM_OUTPUT_USD_PER_MILLION=0.50

# Pon 1 solo después de construir la imagen: docker build -t revisor-compiscript:v1 sandbox
ENABLE_RUNNER=0
RUNNER_IMAGE=revisor-compiscript:v1
PORT=8000
